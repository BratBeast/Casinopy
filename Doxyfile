# Doxyfile 1.9.8 - Конфігурація для Casinopy (Python)

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "Casinopy"
PROJECT_NUMBER         = 1.0
PROJECT_BRIEF          = "Симулятор казино з рефактореним двигуном"
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = Ukrainian

# --- Налаштування збірки ---
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_PACKAGE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

# --- Специфічні налаштування для Python ---
OPTIMIZE_OUTPUT_JAVA   = YES
PYTHON_DOCSTRING       = YES
AUTOLINK_SUPPORT       = YES
CASE_SENSE_NAMES       = YES

# --- Вхідні файли ---
INPUT                  = .
FILE_PATTERNS          = *.py
RECURSIVE              = YES
EXCLUDE                = venv/ .git/ __pycache__/

# --- Формат виводу ---
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE        = TOGGLE
HTML_DYNAMIC_MENUS     = YES
HTML_CODE_FOLDING      = YES

# Вимикаємо важкий LaTeX, якщо він тобі не потрібен для звіту
GENERATE_LATEX         = NO

# --- Графіки та діаграми (Потребує встановленого Graphviz) ---
HAVE_DOT               = YES
UML_LOOK               = YES
TEMPLATE_RELATIONS     = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
DIRECTORY_GRAPH        = YES
DOT_IMAGE_FORMAT       = png
DOT_CLEANUP            = YES